# Copy to .env and adjust. Every value is optional unless noted.

# Database (SQLite by default; use a dedicated database/user on your existing PostgreSQL server in production)
# For Docker, POSTGRES_HOST must be the PostgreSQL container name on a shared Docker network.
# Set POSTGRES_DOCKER_NETWORK when using docker-compose.postgres.yml.
# URL-encode special characters in the password when building DATABASE_URL.
DATABASE_URL=sqlite:///data/database.db
# DATABASE_URL=postgresql+psycopg://lexai_user:encoded_password@POSTGRES_HOST:5432/lexai
# POSTGRES_DOCKER_NETWORK=your_existing_postgres_network

# Dev server
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=0
# Create tables from the models on startup (local dev only; otherwise run `alembic upgrade head`)
DB_AUTO_CREATE=0

# Comma-separated origins allowed to call the API from a browser (no trailing slash)
CORS_ORIGINS=http://localhost:3000,https://lexai.altrisco.tech
# Set to 1 when running behind one reverse proxy, so IP rate limits see the real client IP
TRUST_PROXY=0

# Redis for rate limits and quotas (falls back to per-process counters if unreachable)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Limits
TOKEN_TTL_HOURS=24
SESSION_RATE_LIMIT=1000
LOGIN_ATTEMPTS_PER_15_MIN=10
REGISTRATIONS_PER_HOUR=5
MAX_ACTIVE_API_KEYS=20

# Grading
# Create a project API key at https://console.cencori.com/home
CENCORI_API_KEY=
CENCORI_MODEL=gpt-6-luna
# Optional for testing a compatible Cencori endpoint
CENCORI_BASE_URL=https://api.cencori.com/v1
PALM_API_KEY=
COHERE_API_KEY=
HUGGINGFACE_API_KEY=
# Grades below this confidence are stored as needs_review and excluded from totals
REVIEW_CONFIDENCE_THRESHOLD=0.6
# When every AI provider fails, estimate with text similarity (always flagged needs_review)
ALLOW_SIMILARITY_FALLBACK=1
